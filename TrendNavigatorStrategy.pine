//
// ═══════════════════════════════════════════════════════════════════════════════
//  TREND NAVIGATOR — STRATEGY (backtest-versie van TrendNavigator.pine)
// ═══════════════════════════════════════════════════════════════════════════════
//  Zelfde signaallogica als de indicator, maar met echte orders zodat je in de
//  Strategy Tester winstfactor, drawdown, aantal trades enz. ziet.
//
//  • Entry op de open van de candle ná het signaal (realistisch)
//  • Start-stop = 2× ATR, daarna trailing stop op 3× ATR van de hoogste high /
//    laagste low sinds entry (of optioneel een vaste TP)
//  • Tegengesteld signaal = omdraaien (of alleen sluiten bij "Alleen long")
//  • Herinstap na stop-out zolang de trend intact is
//  • BTC-trendfilter voor altcoins
//  • Positiegrootte: X% risico van de equity tot de start-stop (max. hefboom)
//  • Kosten: 0,07% per kant (0,05% fee + ~0,02% slippage)
//
//  Aanbevolen: 4H-chart, BTC / ETH / SOL / HYPE (USDT-perp of spot).
// ═══════════════════════════════════════════════════════════════════════════════

//@version=6
strategy("Trend Navigator Strategy", shorttitle = "TrendNav-S", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     margin_long = 20, margin_short = 20,
     commission_type = strategy.commission.percent, commission_value = 0.07, pyramiding = 0,
     calc_on_every_tick = false, process_orders_on_close = false)

// ─── Instellingen (zelfde standaardwaarden als de indicator) ───────────────────
grpEma = "EMA's"
lenFast = input.int(9,   "Snelle EMA", minval = 1, group = grpEma, inline = "lint")
lenSlow = input.int(21,  "Trage EMA",  minval = 1, group = grpEma, inline = "lint")
lenMid  = input.int(50,  "Trend EMA",  minval = 1, group = grpEma, inline = "trend")
lenLong = input.int(200, "Lange EMA",  minval = 1, group = grpEma, inline = "trend")

grpSig = "Signalen"
sigWindow     = input.int(3, "Bevestigingsvenster na cross (bars)", minval = 0, maxval = 20, group = grpSig)
useLongFilter = input.bool(true, "Alleen long boven / short onder lange EMA", group = grpSig)
useRsi        = input.bool(true, "RSI-filter", group = grpSig)
rsiLen        = input.int(14, "RSI lengte", minval = 1, group = grpSig, inline = "rsi")
rsiOB         = input.float(70, "OB", group = grpSig, inline = "rsi")
rsiOS         = input.float(30, "OS", group = grpSig, inline = "rsi")
longOnly      = input.bool(false, "Alleen long (SELL = sluiten)", group = grpSig)

grpAdx = "ADX / DMI"
diLen     = input.int(14, "DI lengte", minval = 1, group = grpAdx, inline = "adx")
adxSmooth = input.int(14, "ADX smoothing", minval = 1, group = grpAdx, inline = "adx")
adxMin    = input.float(15, "Min. ADX", minval = 0, step = 0.5, group = grpAdx)
useAdxUp  = input.bool(false, "ADX moet stijgen", group = grpAdx)

grpVol = "Volume"
useVol  = input.bool(true, "Volume-filter", group = grpVol)
volLen  = input.int(20, "Volume gemiddelde", minval = 1, group = grpVol)
volMult = input.float(1.0, "Min. relatief volume", minval = 0, step = 0.1, group = grpVol)

grpHtf = "Hogere timeframe"
useHtf = input.bool(true, "HTF-trendfilter", group = grpHtf)
htf    = input.timeframe("D", "HTF timeframe", group = grpHtf)

grpRisk = "Risico (ATR)"
exitMode  = input.string("Trailing stop", "Exit-methode", options = ["Trailing stop", "Vaste TP"], group = grpRisk)
atrLen    = input.int(14, "ATR lengte", minval = 1, group = grpRisk)
slMult    = input.float(2.0, "Start-stop (x ATR)", minval = 0.1, step = 0.1, group = grpRisk)
trailMult = input.float(3.0, "Trailing afstand (x ATR)", minval = 0.1, step = 0.1, group = grpRisk)
tpMult    = input.float(3.0, "Take-profit (x ATR, alleen Vaste TP)", minval = 0.1, step = 0.1, group = grpRisk)
usePartial = input.bool(false, "Deels winst nemen (TP1)", group = grpRisk,
     tooltip = "Backtest: verlaagt het rendement op alle munten zonder de drawdown te verlagen. Standaard uit.")
ptR        = input.float(2.0, "TP1 op (x R)", minval = 0.5, step = 0.5, group = grpRisk, inline = "pt")
ptFrac     = input.float(50, "deel (%)", minval = 5, maxval = 95, step = 5, group = grpRisk, inline = "pt")
ptBE       = input.bool(true, "Stop naar break-even na TP1", group = grpRisk)
bool useTrail = exitMode == "Trailing stop"

grpRe = "Herinstap & BTC-filter"
useReEntry = input.bool(true, "Herinstap na stop als trend intact", group = grpRe)
reMax      = input.int(1, "Max. herinstappen per trend", minval = 1, maxval = 5, group = grpRe)
useBtc     = input.bool(true, "BTC-trendfilter voor altcoins", group = grpRe)
btcSym     = input.symbol("BINANCE:BTCUSDT", "BTC-symbool", group = grpRe)

grpSize = "Positiegrootte"
sizeMode = input.string("Risico %", "Methode", options = ["Risico %", "100% equity"], group = grpSize)
riskPct  = input.float(2.0, "Risico per trade (%)", minval = 0.1, maxval = 10, step = 0.25, group = grpSize)
maxLev   = input.float(3.0, "Max. hefboom", minval = 1, maxval = 5, step = 0.5, group = grpSize)

grpDate = "Periode"
useDate   = input.bool(false, "Alleen vanaf startdatum", group = grpDate)
startDate = input.time(timestamp("2023-01-01T00:00:00"), "Startdatum", group = grpDate)
bool inDate = not useDate or time >= startDate

// ─── Berekeningen ──────────────────────────────────────────────────────────────
emaFast = ta.ema(close, lenFast)
emaSlow = ta.ema(close, lenSlow)
emaLong = ta.ema(close, lenLong)
[diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

bool  hasVolume = ta.cum(nz(volume)) > 0
float volAvg    = ta.sma(nz(volume), volLen)
float relVol    = hasVolume and volAvg > 0 ? nz(volume) / volAvg : na

htfTrendCalc() =>
    float e1 = ta.ema(close, lenMid)
    float e2 = ta.ema(close, lenLong)
    int   t  = close > e1 and e1 > e2 ? 1 : close < e1 and e1 < e2 ? -1 : 0
    t[1]

bool htfValid   = timeframe.in_seconds(htf) >= timeframe.in_seconds(timeframe.period)
int  htfTrendRq = request.security(syminfo.tickerid, htf, htfTrendCalc(), lookahead = barmerge.lookahead_on)
bool htfActive  = useHtf and htfValid
int  htfTrend   = htfActive ? nz(htfTrendRq) : 0

btcTrendCalc() =>
    float e1 = ta.ema(close, lenMid)
    float e2 = ta.ema(close, lenLong)
    close > e1 and e1 > e2 ? 1 : close < e1 and e1 < e2 ? -1 : 0

bool isBtc      = syminfo.basecurrency == "BTC"
int  btcTrendRq = request.security(btcSym, timeframe.period, btcTrendCalc(), ignore_invalid_symbol = true)
int  btcTrend   = useBtc and not isBtc ? nz(btcTrendRq) : 0
emaMid = ta.ema(close, lenMid)

// ─── Signalen ──────────────────────────────────────────────────────────────────
bool crossUp = ta.crossover(emaFast, emaSlow)
bool crossDn = ta.crossunder(emaFast, emaSlow)
bool bullSetup = nz(ta.barssince(crossUp), 9999) <= sigWindow and emaFast > emaSlow
bool bearSetup = nz(ta.barssince(crossDn), 9999) <= sigWindow and emaFast < emaSlow

bool adxOk = adx >= adxMin and (not useAdxUp or adx > adx[1])
bool volOk = not useVol or not hasVolume or nz(relVol) >= volMult

bool longOk  = adxOk and volOk and diPlus > diMinus and
     (not useLongFilter or close > emaLong) and (not htfActive or htfTrend >= 0) and btcTrend >= 0 and (not useRsi or rsi < rsiOB)
bool shortOk = adxOk and volOk and diMinus > diPlus and
     (not useLongFilter or close < emaLong) and (not htfActive or htfTrend <= 0) and btcTrend <= 0 and (not useRsi or rsi > rsiOS)

var bool usedUp = false
var bool usedDn = false
if crossUp
    usedUp := false
if crossDn
    usedDn := false
bool buySignal  = bullSetup and longOk  and not usedUp
bool sellSignal = bearSetup and shortOk and not usedDn
if buySignal
    usedUp := true
if sellSignal
    usedDn := true

// ─── Orders ────────────────────────────────────────────────────────────────────
var float longStop  = na
var float shortStop = na
var float longTp    = na
var float shortTp   = na
var float extPx     = na
var int   canRe     = 0
var int   reCount   = 0
var float longTp1   = na
var float shortTp1  = na
var bool  tp1Done   = false

// 1) gestopt (niet omgedraaid)? → herinstap mogelijk
if strategy.position_size == 0 and strategy.position_size[1] != 0 and strategy.closedtrades > 0
    if strategy.closedtrades.exit_comment(strategy.closedtrades - 1) == "stop"
        canRe := strategy.position_size[1] > 0 ? 1 : -1

// TP1 gevuld? (positie kleiner geworden, zelfde richting) → evt. stop naar break-even
if not tp1Done and strategy.position_size != 0 and math.sign(strategy.position_size) == math.sign(strategy.position_size[1]) and
     math.abs(strategy.position_size) < math.abs(strategy.position_size[1])
    tp1Done := true
    if ptBE and strategy.position_size > 0
        longStop := math.max(longStop, strategy.position_avg_price)
    else if ptBE and strategy.position_size < 0
        shortStop := math.min(shortStop, strategy.position_avg_price)

// 2) trailing stop bijwerken zolang we in een positie zitten
if useTrail and strategy.position_size > 0
    extPx    := math.max(extPx, high)
    longStop := math.max(longStop, extPx - atr * trailMult)
else if useTrail and strategy.position_size < 0
    extPx     := math.min(extPx, low)
    shortStop := math.min(shortStop, extPx + atr * trailMult)

// 3) herinstap-voorwaarden
if buySignal or sellSignal
    canRe   := 0
    reCount := 0
bool closeUpFast = close > emaFast and close[1] <= emaFast[1]
bool closeDnFast = close < emaFast and close[1] >= emaFast[1]
bool flat   = strategy.position_size == 0
bool reBuy  = useReEntry and flat and canRe == 1 and reCount < reMax and closeUpFast and emaMid > emaLong and close > emaLong and
     (not htfActive or htfTrend == 1) and btcTrend >= 0 and diPlus > diMinus and (not useRsi or rsi < rsiOB) and not buySignal and not sellSignal
bool reSell = useReEntry and flat and canRe == -1 and reCount < reMax and closeDnFast and emaMid < emaLong and close < emaLong and
     (not htfActive or htfTrend == -1) and btcTrend <= 0 and diMinus > diPlus and (not useRsi or rsi > rsiOS) and not buySignal and not sellSignal and not longOnly
if (canRe == 1 and emaMid < emaLong) or (canRe == -1 and emaMid > emaLong)
    canRe := 0

// 4) positiegrootte
calcQty() =>
    float stopDist = atr * slMult
    float q = sizeMode == "Risico %" ? strategy.equity * riskPct / 100 / stopDist : strategy.equity / close
    math.min(q, maxLev * strategy.equity / close)

// 5) orders
if inDate and (buySignal or reBuy) and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, qty = calcQty(), comment = reBuy ? "RE-BUY" : "BUY")
    longStop := close - atr * slMult
    longTp   := useTrail ? na : close + atr * tpMult
    longTp1  := close + ptR * atr * slMult
    tp1Done  := false
    extPx    := close
    if reBuy
        reCount += 1
else if inDate and (sellSignal or reSell)
    if longOnly and sellSignal
        strategy.close("Long", comment = "SELL")
    else if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, qty = calcQty(), comment = reSell ? "RE-SELL" : "SELL")
        shortStop := close + atr * slMult
        shortTp   := useTrail ? na : close - atr * tpMult
        shortTp1  := close - ptR * atr * slMult
        tp1Done   := false
        extPx     := close
        if reSell
            reCount += 1

if usePartial and not tp1Done
    strategy.exit("TP1L", "Long",  qty_percent = ptFrac, limit = longTp1,  stop = longStop,  comment_loss = "stop", comment_profit = "TP1")
    strategy.exit("TP1S", "Short", qty_percent = ptFrac, limit = shortTp1, stop = shortStop, comment_loss = "stop", comment_profit = "TP1")
strategy.exit("XL", "Long",  stop = longStop,  limit = longTp,  comment_loss = "stop", comment_profit = "TP")
strategy.exit("XS", "Short", stop = shortStop, limit = shortTp, comment_loss = "stop", comment_profit = "TP")

// ─── Plots ─────────────────────────────────────────────────────────────────────
color ribCol = emaFast > emaSlow ? color.new(#00C853, 0) : color.new(#FF1744, 0)
p1 = plot(emaFast, "EMA snel",  color = ribCol)
p2 = plot(emaSlow, "EMA traag", color = ribCol)
fill(p1, p2, color = color.new(ribCol, 75))
plot(emaLong, "EMA lang", color = color.new(#7E57C2, 0), linewidth = 2)
float curStop = strategy.position_size > 0 ? longStop : strategy.position_size < 0 ? shortStop : na
float curTp   = strategy.position_size > 0 ? longTp   : strategy.position_size < 0 ? shortTp   : na
plot(curStop, "Stop", color = color.new(#FF1744, 0), style = plot.style_linebr, linewidth = 2)
plot(useTrail ? na : curTp, "TP", color = color.new(#00C853, 0), style = plot.style_linebr)
