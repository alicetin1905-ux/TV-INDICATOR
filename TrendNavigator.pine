// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// ═══════════════════════════════════════════════════════════════════════════════
//  TREND NAVIGATOR  —  EMA-lint • ADX/DMI • Volume • RSI • Hogere timeframe
// ═══════════════════════════════════════════════════════════════════════════════
//  In één oogopslag:
//   • Candlekleur   = trendtoestand (groen = bull, rood = bear, grijs = geen trend)
//   • EMA-lint 9/21 = korte-termijn richting, EMA 50/200 = hoofdtrend
//   • BUY / SELL    = EMA-cross bevestigd door ADX, volume, EMA 200, HTF en RSI
//   • Stop          = ATR-trailing stop (of vaste SL/TP) na elk signaal
//   • RE-BUY/RE-SELL= herinstap na stop-out zolang de trend intact is
//   • BTC-filter    = geen alt-long tegen een bearish BTC in (en omgekeerd)
//   • Positiegrootte= hoeveel je koopt voor X% risico tot de stop
//   • Liquidaties   = liquidatie-golven (open interest) + geschatte liq-niveaus
//   • Dashboard     = alle componenten + trendscore + positie + statistiek
//
//  Signalen worden pas bij het sluiten van de candle gegeven (geen repaint).
//
//  Standaardinstellingen zijn gebacktest op BTC, ETH, SOL en HYPE (OKX, 4H,
//  2022–2026, incl. kosten) met train/test-split. Beste timeframe: 4H.
//  Zie README.md en TrendNavigatorStrategy.pine voor de backtest.
// ═══════════════════════════════════════════════════════════════════════════════

//@version=6
indicator("Trend Navigator [EMA • ADX • Volume]", shorttitle = "TrendNav", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// INSTELLINGEN
// ─────────────────────────────────────────────────────────────────────────────
grpEma = "EMA's"
lenFast     = input.int(9,   "Snelle EMA",  minval = 1, group = grpEma, inline = "lint")
lenSlow     = input.int(21,  "Trage EMA",   minval = 1, group = grpEma, inline = "lint")
lenMid      = input.int(50,  "Trend EMA",   minval = 1, group = grpEma, inline = "trend")
lenLong     = input.int(200, "Lange EMA",   minval = 1, group = grpEma, inline = "trend")
showRibbon  = input.bool(true, "Toon EMA-lint (snel/traag)", group = grpEma)
showMidLong = input.bool(true, "Toon trend-EMA's (50/200)", group = grpEma)

grpSig = "Signalen"
sigWindow     = input.int(3, "Bevestigingsvenster na cross (bars)", minval = 0, maxval = 20, group = grpSig,
     tooltip = "Hoeveel bars na de EMA-cross de filters alsnog mogen bevestigen. 0 = alleen op de cross-candle zelf.")
useLongFilter = input.bool(true, "Alleen BUY boven / SELL onder lange EMA", group = grpSig)
useRsi        = input.bool(true, "RSI-filter (geen BUY overbought / SELL oversold)", group = grpSig)
rsiLen        = input.int(14, "RSI lengte", minval = 1, group = grpSig, inline = "rsi")
rsiOB         = input.float(70, "OB", minval = 50, maxval = 100, group = grpSig, inline = "rsi")
rsiOS         = input.float(30, "OS", minval = 0,  maxval = 50,  group = grpSig, inline = "rsi")

grpAdx = "ADX / DMI (trendsterkte)"
diLen     = input.int(14, "DI lengte", minval = 1, group = grpAdx, inline = "adx")
adxSmooth = input.int(14, "ADX smoothing", minval = 1, group = grpAdx, inline = "adx")
adxMin    = input.float(15, "Min. ADX (trend aanwezig)", minval = 0, step = 0.5, group = grpAdx,
     tooltip = "Onder deze waarde is de markt zijwaarts: candles worden grijs en er komen geen signalen.")
adxStrong = input.float(30, "Sterke trend vanaf", minval = 0, step = 0.5, group = grpAdx)
useAdxUp  = input.bool(false, "ADX moet stijgen voor signaal", group = grpAdx)

grpVol = "Volume"
useVol  = input.bool(true, "Volume-filter gebruiken", group = grpVol,
     tooltip = "Wordt automatisch overgeslagen op symbolen zonder volumedata (bv. forex bij sommige brokers).")
volLen  = input.int(20, "Volume gemiddelde (bars)", minval = 1, group = grpVol)
volMult = input.float(1.0, "Min. relatief volume (x gemiddelde)", minval = 0, step = 0.1, group = grpVol)

grpHtf = "Hogere timeframe (HTF)"
useHtf = input.bool(true, "HTF-trendfilter gebruiken", group = grpHtf,
     tooltip = "Geen BUY als de hogere timeframe bearish is, geen SELL als die bullish is. Werkt alleen als HTF ≥ chart-timeframe.")
htf    = input.timeframe("D", "HTF timeframe", group = grpHtf, tooltip = "Vuistregel: ±6× de chart-timeframe. 4H-chart → D, 1H-chart → 4H.")

grpRisk = "Risico (ATR)"
showSlTp  = input.bool(true, "Toon stop / TP lijnen", group = grpRisk)
exitMode  = input.string("Trailing stop", "Exit-methode", options = ["Trailing stop", "Vaste TP"], group = grpRisk,
     tooltip = "Trailing stop laat winnaars doorlopen (beste resultaat in de backtest). Vaste TP sluit op een vast ATR-doel.")
atrLen    = input.int(14, "ATR lengte", minval = 1, group = grpRisk)
slMult    = input.float(2.0, "Start-stop (x ATR)", minval = 0.1, step = 0.1, group = grpRisk)
trailMult = input.float(3.0, "Trailing afstand (x ATR)", minval = 0.1, step = 0.1, group = grpRisk,
     tooltip = "Afstand van de stop tot de hoogste high (long) / laagste low (short) sinds entry.")
tpMult    = input.float(3.0, "Take-profit (x ATR, alleen bij Vaste TP)", minval = 0.1, step = 0.1, group = grpRisk)
usePartial = input.bool(false, "Deels winst nemen (TP1)", group = grpRisk,
     tooltip = "Neemt een deel winst op X keer het risico (R = afstand entry → start-stop). Backtest: verlaagt het rendement op alle munten (BTC +97% → +48% bij 50% op 2R) zonder de drawdown te verlagen. Alleen voor wie een hogere winrate prettiger vindt.")
ptR        = input.float(2.0, "TP1 op (x R)", minval = 0.5, step = 0.5, group = grpRisk, inline = "pt")
ptFrac     = input.float(50, "deel (%)", minval = 5, maxval = 95, step = 5, group = grpRisk, inline = "pt")
ptBE       = input.bool(true, "Stop naar break-even na TP1", group = grpRisk)
bool useTrail = exitMode == "Trailing stop"

grpRe = "Herinstap & BTC-filter"
useReEntry = input.bool(true, "Herinstap na stop als trend intact", group = grpRe,
     tooltip = "Na een stop-out: opnieuw instappen als de koers weer boven EMA-snel sluit, terwijl EMA 50 > EMA 200, koers > EMA 200 en de HTF-trend bullish is (short: spiegelbeeld). Vervalt bij een tegengestelde EMA 50/200-cross.")
reMax      = input.int(1, "Max. herinstappen per trend", minval = 1, maxval = 5, group = grpRe)
useBtc     = input.bool(true, "BTC-trendfilter voor altcoins", group = grpRe,
     tooltip = "Geen long op een altcoin als BTC bearish is (koers < EMA 50 < EMA 200 op dezelfde timeframe), geen short als BTC bullish is. Op BTC zelf genegeerd. Backtest: helpt vooral SOL, kost HYPE rendement.")
btcSym     = input.symbol("BINANCE:BTCUSDT", "BTC-symbool", group = grpRe)

grpSize = "Positiegrootte"
showSize = input.bool(true, "Toon positiegrootte bij signaal", group = grpSize)
accSize  = input.float(10000, "Accountgrootte (in quote, bv. USDT)", minval = 1, step = 100, group = grpSize)
riskPct  = input.float(1.0, "Risico per trade (%)", minval = 0.1, maxval = 10, step = 0.25, group = grpSize,
     tooltip = "Verlies als de start-stop geraakt wordt. Backtest: 1–2% geeft veel lagere drawdown dan 100% inzet.")
maxLev   = input.float(3.0, "Max. hefboom", minval = 1, step = 0.5, group = grpSize)

grpLiq = "Liquidaties (crypto perps)"
showLiqEv  = input.bool(true, "Toon liquidatie-golven (open interest)", group = grpLiq,
     tooltip = "Oranje bol onder de candle = longs geliquideerd, blauwe bol boven = shorts geliquideerd. Gedetecteerd als een abnormale daling van open interest met een candle in dezelfde richting. Grotere bol = heftiger.")
oiSymIn    = input.string("", "Open-interest symbool (leeg = automatisch)", group = grpLiq,
     tooltip = "Automatisch = de perp van dezelfde exchange, bv. BINANCE:BTCUSDT.P_OI. Op exchanges zonder perps (bv. Coinbase) vul je zelf iets in als BINANCE:BTCUSDT.P_OI.")
liqZ       = input.float(2.0, "Gevoeligheid (OI-daling in st.dev.)", minval = 1, step = 0.25, group = grpLiq,
     tooltip = "Lager = meer bollen. 2.0 = getest tegen echte OKX-liquidaties (85% juiste richting).")
showLiqLvl = input.bool(true, "Toon geschatte liquidatie-niveaus", group = grpLiq,
     tooltip = "Vanaf candles met hoog volume wordt berekend waar 25x/50x/100x posities geliquideerd worden. Een niveau verdwijnt zodra de koers het raakt. Niet-geraakte niveaus werken vaak als magneet.")
lev1       = input.int(25,  "Hefboom", minval = 2, maxval = 200, group = grpLiq, inline = "lev")
lev2       = input.int(50,  "",        minval = 2, maxval = 200, group = grpLiq, inline = "lev")
lev3       = input.int(100, "",        minval = 2, maxval = 200, group = grpLiq, inline = "lev")
lvlVolMult = input.float(1.5, "Niveaus vanaf volume ≥ (x gem.)", minval = 0, step = 0.1, group = grpLiq)
lvlBack    = input.int(300, "Niveaus van laatste N bars", minval = 20, maxval = 2000, group = grpLiq)
mmrPct     = input.float(0.5, "Onderhoudsmarge (%)", minval = 0, step = 0.1, group = grpLiq)
colLongLiq  = input.color(#FF9800, "Long-liq", group = grpLiq, inline = "lcol")
colShortLiq = input.color(#00BCD4, "Short-liq", group = grpLiq, inline = "lcol")

grpVis = "Weergave"
colBull    = input.color(#00C853, "Bull", group = grpVis, inline = "col")
colBear    = input.color(#FF1744, "Bear", group = grpVis, inline = "col")
colNeutral = input.color(#787B86, "Neutraal", group = grpVis, inline = "col")
colorBars  = input.bool(true, "Kleur candles naar trend", group = grpVis)
showBg     = input.bool(false, "Achtergrond kleuren naar trend", group = grpVis)
showLabels = input.bool(true, "Toon BUY/SELL labels", group = grpVis)
showTable  = input.bool(true, "Toon dashboard", group = grpVis)
tablePosIn = input.string("Rechtsboven", "Dashboard positie", options = ["Rechtsboven", "Rechtsonder", "Linksboven", "Linksonder"], group = grpVis)
tableSize  = input.string("Klein", "Dashboard tekstgrootte", options = ["Klein", "Normaal", "Groot"], group = grpVis)

// ─────────────────────────────────────────────────────────────────────────────
// BEREKENINGEN
// ─────────────────────────────────────────────────────────────────────────────
emaFast = ta.ema(close, lenFast)
emaSlow = ta.ema(close, lenSlow)
emaMid  = ta.ema(close, lenMid)
emaLong = ta.ema(close, lenLong)

[diPlus, diMinus, adx] = ta.dmi(diLen, adxSmooth)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

// Volume (veilig voor symbolen zonder volume)
bool  hasVolume = ta.cum(nz(volume)) > 0
float volAvg    = ta.sma(nz(volume), volLen)
float relVol    = hasVolume and volAvg > 0 ? nz(volume) / volAvg : na

// Hogere timeframe trend — niet-repaintend: bevestigde HTF-bar ([1]) + lookahead_on
htfTrendCalc() =>
    float e1 = ta.ema(close, lenMid)
    float e2 = ta.ema(close, lenLong)
    int   t  = close > e1 and e1 > e2 ? 1 : close < e1 and e1 < e2 ? -1 : 0
    t[1]

bool htfValid   = timeframe.in_seconds(htf) >= timeframe.in_seconds(timeframe.period)
int  htfTrendRq = request.security(syminfo.tickerid, htf, htfTrendCalc(), lookahead = barmerge.lookahead_on)
bool htfActive  = useHtf and htfValid
int  htfTrend   = htfActive ? nz(htfTrendRq) : 0

// BTC-trend (zelfde timeframe) als filter voor altcoins
btcTrendCalc() =>
    float e1 = ta.ema(close, lenMid)
    float e2 = ta.ema(close, lenLong)
    close > e1 and e1 > e2 ? 1 : close < e1 and e1 < e2 ? -1 : 0

bool isBtc      = syminfo.basecurrency == "BTC"
int  btcTrendRq = request.security(btcSym, timeframe.period, btcTrendCalc(), ignore_invalid_symbol = true)
bool btcActive  = useBtc and not isBtc
int  btcTrend   = btcActive ? nz(btcTrendRq) : 0

// ─────────────────────────────────────────────────────────────────────────────
// TRENDSCORE  (elk component +1 bullish / -1 bearish)
// ─────────────────────────────────────────────────────────────────────────────
int sPrice = close   > emaMid  ? 1 : -1   // prijs t.o.v. trend-EMA
int sRib   = emaFast > emaSlow ? 1 : -1   // EMA-lint
int sTrend = emaMid  > emaLong ? 1 : -1   // EMA 50 vs 200 (golden/death cross)
int sDmi   = diPlus  > diMinus ? 1 : -1   // richting volgens DMI
int sRsi   = rsi     > 50      ? 1 : -1   // momentum
int score    = sPrice + sRib + sTrend + sDmi + sRsi + htfTrend
int maxScore = htfActive ? 6 : 5

bool sideways = adx < adxMin
// 2 = sterk bull, 1 = bull, 0 = neutraal/zijwaarts, -1 = bear, -2 = sterk bear
int trendState = sideways ? 0 :
     score >=  4 and adx >= adxStrong ?  2 :
     score >=  2                      ?  1 :
     score <= -4 and adx >= adxStrong ? -2 :
     score <= -2                      ? -1 : 0

color trendCol = switch trendState
    2  => colBull
    1  => color.new(colBull, 45)
    -1 => color.new(colBear, 45)
    -2 => colBear
    => colNeutral

// ─────────────────────────────────────────────────────────────────────────────
// SIGNALEN
// ─────────────────────────────────────────────────────────────────────────────
bool crossUp = ta.crossover(emaFast, emaSlow)
bool crossDn = ta.crossunder(emaFast, emaSlow)

bool bullSetup = nz(ta.barssince(crossUp), 9999) <= sigWindow and emaFast > emaSlow
bool bearSetup = nz(ta.barssince(crossDn), 9999) <= sigWindow and emaFast < emaSlow

bool adxOk = adx >= adxMin and (not useAdxUp or adx > adx[1])
bool volOk = not useVol or not hasVolume or nz(relVol) >= volMult

bool longOk  = adxOk and volOk and diPlus > diMinus and
     (not useLongFilter or close > emaLong) and
     (not htfActive or htfTrend >= 0) and btcTrend >= 0 and
     (not useRsi or rsi < rsiOB)

bool shortOk = adxOk and volOk and diMinus > diPlus and
     (not useLongFilter or close < emaLong) and
     (not htfActive or htfTrend <= 0) and btcTrend <= 0 and
     (not useRsi or rsi > rsiOS)

// Eén signaal per cross, alleen op een gesloten candle
var bool usedUp = false
var bool usedDn = false
if crossUp
    usedUp := false
if crossDn
    usedDn := false

bool buySignal  = bullSetup and longOk  and not usedUp and barstate.isconfirmed
bool sellSignal = bearSetup and shortOk and not usedDn and barstate.isconfirmed
if buySignal
    usedUp := true
if sellSignal
    usedDn := true

fmtQty(float q) =>
    str.tostring(q, q >= 1000 ? "#,###" : q >= 10 ? "#,###.#" : q >= 1 ? "#.###" : "#.#####")

// ─────────────────────────────────────────────────────────────────────────────
// POSITIE-TRACKING: SL / TP + eenvoudige signaalstatistiek
// ─────────────────────────────────────────────────────────────────────────────
var int   posDir  = 0
var float entryPx = na
var float slPx    = na
var float tpPx    = na
var float extPx   = na
var int   wins    = 0
var int   losses  = 0
var int   lastSig = 0
var int   lastSigBar = na
var int   canRe   = 0      // 1 = long-herinstap mogelijk, -1 = short
var int   reCount = 0
var float posQty  = na
var bool  ptDone  = false   // TP1 al genomen?
var float ptRet   = 0.0     // rendement van het TP1-deel
var float rDist   = na      // R = afstand entry → start-stop

// 1) bestaande positie: stop of TP geraakt? (bij beide in één candle: conservatief de stop)
bool  exitHit = false
float exitPx  = na
if posDir == 1
    if low <= slPx
        exitHit := true
        exitPx  := slPx
    else if not useTrail and high >= tpPx
        exitHit := true
        exitPx  := tpPx
else if posDir == -1
    if high >= slPx
        exitHit := true
        exitPx  := slPx
    else if not useTrail and low <= tpPx
        exitHit := true
        exitPx  := tpPx

if exitHit
    if exitPx == slPx   // gestopt (niet via TP) → herinstap mogelijk
        canRe := posDir
    float pnl = posDir * (exitPx / entryPx - 1) * 100
    if ptDone   // gewogen met het eerder genomen TP1-deel
        pnl := ptFrac / 100 * ptRet + (1 - ptFrac / 100) * pnl
    if pnl > 0
        wins += 1
    else
        losses += 1
    if showSlTp
        label.new(bar_index, exitPx, "EXIT " + (pnl > 0 ? "+" : "") + str.tostring(pnl, "#.0") + "%",
             style = posDir == 1 ? label.style_label_upper_left : label.style_label_lower_left,
             color = color.new(pnl > 0 ? colBull : colBear, 30), textcolor = color.white, size = size.tiny)
    posDir := 0

// TP1: deels winst nemen op ptR x R (na de stop-check: conservatief)
float tp1Px = posDir != 0 and usePartial and not ptDone ? entryPx + posDir * ptR * rDist : na
if not na(tp1Px) and (posDir == 1 ? high >= tp1Px : low <= tp1Px)
    ptDone := true
    ptRet  := posDir * (tp1Px / entryPx - 1) * 100
    if ptBE
        slPx := posDir == 1 ? math.max(slPx, entryPx) : math.min(slPx, entryPx)
    if showSlTp
        label.new(bar_index, tp1Px, "TP1 " + str.tostring(ptFrac, "#") + "% +" + str.tostring(ptRet, "#.0") + "%",
             style = posDir == 1 ? label.style_label_lower_left : label.style_label_upper_left,
             color = color.new(colBull, 30), textcolor = color.white, size = size.tiny)

// trailing stop bijwerken (geldt vanaf de volgende candle)
if useTrail and posDir == 1
    extPx := math.max(extPx, high)
    slPx  := math.max(slPx, extPx - atr * trailMult)
else if useTrail and posDir == -1
    extPx := math.min(extPx, low)
    slPx  := math.min(slPx, extPx + atr * trailMult)

// 2) herinstap na stop-out zolang de trend intact is
if buySignal or sellSignal
    canRe   := 0
    reCount := 0
bool closeUpFast = close > emaFast and close[1] <= emaFast[1]
bool closeDnFast = close < emaFast and close[1] >= emaFast[1]
bool reBuy  = useReEntry and barstate.isconfirmed and posDir == 0 and canRe == 1 and reCount < reMax and
     closeUpFast and emaMid > emaLong and close > emaLong and (not htfActive or htfTrend == 1) and btcTrend >= 0 and
     diPlus > diMinus and (not useRsi or rsi < rsiOB) and not buySignal and not sellSignal
bool reSell = useReEntry and barstate.isconfirmed and posDir == 0 and canRe == -1 and reCount < reMax and
     closeDnFast and emaMid < emaLong and close < emaLong and (not htfActive or htfTrend == -1) and btcTrend <= 0 and
     diMinus > diPlus and (not useRsi or rsi > rsiOS) and not buySignal and not sellSignal
if (canRe == 1 and emaMid < emaLong) or (canRe == -1 and emaMid > emaLong)
    canRe := 0   // trend gebroken

// 3) nieuw signaal of herinstap (sluit een tegengestelde positie op de slotkoers)
if buySignal or sellSignal or reBuy or reSell
    int  newDir = buySignal or reBuy ? 1 : -1
    bool isRe   = reBuy or reSell
    if isRe
        reCount += 1
    if posDir == -newDir
        bool won = posDir == 1 ? close > entryPx : close < entryPx
        if won
            wins += 1
        else
            losses += 1
    if posDir != newDir   // al in dezelfde richting? dan positie (en stop) behouden
        posDir  := newDir
        entryPx := close
        slPx    := close - newDir * atr * slMult
        tpPx    := useTrail ? na : close + newDir * atr * tpMult
        extPx   := close
        rDist   := math.abs(close - slPx)
        ptDone  := false
        ptRet   := 0.0
        // positiegrootte: risico / stopafstand, begrensd door max. hefboom
        float stopDist = math.abs(close - slPx)
        posQty  := stopDist > 0 ? math.min(accSize * riskPct / 100 / stopDist, maxLev * accSize / close) : na
    lastSig    := newDir
    lastSigBar := bar_index
    if showLabels
        string sizeTxt = showSize and not na(posQty) ? "\n" + fmtQty(posQty) + " " + syminfo.basecurrency + " • " + str.tostring(riskPct, "#.##") + "%" : ""
        string txt = (isRe ? "RE-" : "") + (newDir == 1 ? "BUY" : "SELL") + "\n" + (score > 0 ? "+" : "") + str.tostring(score) + "/" + str.tostring(maxScore) + sizeTxt
        label.new(bar_index, close, txt,
             yloc = newDir == 1 ? yloc.belowbar : yloc.abovebar,
             style = newDir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(newDir == 1 ? colBull : colBear, isRe ? 35 : 0), textcolor = color.white, size = isRe ? size.tiny : size.small)

// ─────────────────────────────────────────────────────────────────────────────
// LIQUIDATIES
// ─────────────────────────────────────────────────────────────────────────────
// 1) Liquidatie-golven via open interest (OI). Gedwongen sluitingen laten OI
//    abnormaal snel dalen; de candlerichting zegt wie er geliquideerd werd.
string oiAuto   = str.endswith(syminfo.ticker, ".P") ? syminfo.prefix + ":" + syminfo.ticker + "_OI" : syminfo.prefix + ":" + syminfo.ticker + ".P_OI"
string oiTicker = str.length(oiSymIn) > 0 ? oiSymIn : oiAuto
float  oiClose  = request.security(oiTicker, timeframe.period, close, ignore_invalid_symbol = true)
bool   hasOi    = not na(oiClose)
float  dOi      = hasOi and nz(oiClose[1]) > 0 ? oiClose / oiClose[1] - 1 : na
float  dOiSd    = ta.stdev(dOi, 50)
float  oiZ      = dOiSd > 0 ? dOi / dOiSd : na
bool   liqEvent = hasOi and nz(oiZ) <= -liqZ
bool   longLiq  = liqEvent and close < open
bool   shortLiq = liqEvent and close > open
float  liqSize  = liqEvent ? -oiZ : 0.0

var int lastLiqDir = 0
var int lastLiqBar = na
if longLiq or shortLiq
    lastLiqDir := longLiq ? 1 : -1
    lastLiqBar := bar_index

int   bars24  = math.max(1, math.round(86400 / timeframe.in_seconds(timeframe.period)))
float oiChg24 = hasOi and nz(oiClose[bars24]) > 0 ? (oiClose / oiClose[bars24] - 1) * 100 : na

// 2) Geschatte liquidatie-niveaus (hefboom-heatmap light)
var array<line>  lvlLines = array.new<line>()
var array<float> lvlPx    = array.new<float>()
var array<int>   lvlSide  = array.new<int>()   // 1 = long-liq (onder de koers), -1 = short-liq (erboven)

addLevel(float px, int side, int lev) =>
    color c = side == 1 ? colLongLiq : colShortLiq
    int   w = lev <= math.min(lev1, lev2, lev3) ? 3 : lev >= math.max(lev1, lev2, lev3) ? 1 : 2
    array.push(lvlLines, line.new(bar_index, px, bar_index + 1, px, color = color.new(c, 40), width = w))
    array.push(lvlPx, px)
    array.push(lvlSide, side)
    if array.size(lvlLines) > 150   // begrens: oudste niveau weg
        line.delete(array.shift(lvlLines))
        array.shift(lvlPx)
        array.shift(lvlSide)

if showLiqLvl and array.size(lvlLines) > 0
    for i = array.size(lvlLines) - 1 to 0
        float lp   = array.get(lvlPx, i)
        int   side = array.get(lvlSide, i)
        bool  hit  = side == 1 ? low <= lp : high >= lp
        if hit   // niveau "opgeveegd": posities geliquideerd → verwijderen
            line.delete(array.get(lvlLines, i))
            array.remove(lvlLines, i)
            array.remove(lvlPx, i)
            array.remove(lvlSide, i)
        else
            line.set_x2(array.get(lvlLines, i), bar_index + 1)

if showLiqLvl and bar_index >= last_bar_index - lvlBack and hasVolume and nz(relVol) >= lvlVolMult
    float ep = hlc3
    for lev in array.from(lev1, lev2, lev3)
        addLevel(ep * (1 - 1.0 / lev + mmrPct / 100), 1, lev)
        addLevel(ep * (1 + 1.0 / lev - mmrPct / 100), -1, lev)

// ─────────────────────────────────────────────────────────────────────────────
// PLOTS
// ─────────────────────────────────────────────────────────────────────────────
color ribCol = emaFast > emaSlow ? colBull : colBear
pFast = plot(showRibbon ? emaFast : na, "EMA snel",  color = ribCol, linewidth = 1)
pSlow = plot(showRibbon ? emaSlow : na, "EMA traag", color = ribCol, linewidth = 1)
fill(pFast, pSlow, color = color.new(ribCol, 75), title = "EMA-lint vulling")

plot(showMidLong ? emaMid  : na, "EMA trend", color = color.new(#FF9800, 0), linewidth = 2)
plot(showMidLong ? emaLong : na, "EMA lang",  color = color.new(#7E57C2, 0), linewidth = 3)

bool showPos = showSlTp and posDir != 0
plot(showPos ? slPx    : na, "Stop",        color = color.new(colBear, 0), style = plot.style_linebr, linewidth = 2)
plot(showPos and usePartial and not ptDone ? entryPx + posDir * ptR * rDist : na, "TP1", color = color.new(colBull, 40), style = plot.style_linebr, linewidth = 1)
plot(showPos and not useTrail ? tpPx : na, "Take-profit", color = color.new(colBull, 0), style = plot.style_linebr, linewidth = 1)
plot(showPos ? entryPx : na, "Entry",       color = color.new(colNeutral, 30), style = plot.style_linebr, linewidth = 1)

barcolor(colorBars ? trendCol : na, title = "Trendkleur candles")
bgcolor(showBg ? color.new(trendCol, 90) : na, title = "Trendkleur achtergrond")

bool showL = showLiqEv and longLiq
bool showS = showLiqEv and shortLiq
plotshape(showL and liqSize <  3 ? low  - atr * 0.4 : na, "Long-liq",         shape.circle, location.absolute, color.new(colLongLiq, 25),  size = size.tiny)
plotshape(showL and liqSize >= 3 and liqSize < 4.5 ? low - atr * 0.4 : na, "Long-liq groot", shape.circle, location.absolute, color.new(colLongLiq, 15), size = size.small)
plotshape(showL and liqSize >= 4.5 ? low  - atr * 0.4 : na, "Long-liq extreem", shape.circle, location.absolute, color.new(colLongLiq, 0),   size = size.normal)
plotshape(showS and liqSize <  3 ? high + atr * 0.4 : na, "Short-liq",         shape.circle, location.absolute, color.new(colShortLiq, 25), size = size.tiny)
plotshape(showS and liqSize >= 3 and liqSize < 4.5 ? high + atr * 0.4 : na, "Short-liq groot", shape.circle, location.absolute, color.new(colShortLiq, 15), size = size.small)
plotshape(showS and liqSize >= 4.5 ? high + atr * 0.4 : na, "Short-liq extreem", shape.circle, location.absolute, color.new(colShortLiq, 0),  size = size.normal)

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(buySignal,  "TrendNav BUY",  "TrendNav BUY {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(sellSignal, "TrendNav SELL", "TrendNav SELL {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(trendState >= 1 and trendState[1] < 1,  "Trend wordt bullish", "TrendNav: {{ticker}} trend wordt BULLISH")
alertcondition(trendState <= -1 and trendState[1] > -1, "Trend wordt bearish", "TrendNav: {{ticker}} trend wordt BEARISH")
alertcondition(longLiq,  "Long-liquidaties",  "TrendNav: {{ticker}} long-liquidatiegolf (OI-daling + rode candle) @ {{close}}")
alertcondition(shortLiq, "Short-liquidaties", "TrendNav: {{ticker}} short-squeeze (OI-daling + groene candle) @ {{close}}")

alertcondition(reBuy,  "TrendNav RE-BUY",  "TrendNav RE-BUY (herinstap) {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(reSell, "TrendNav RE-SELL", "TrendNav RE-SELL (herinstap) {{ticker}} ({{interval}}) @ {{close}}")

if buySignal or sellSignal or reBuy or reSell
    alert((reBuy or reSell ? "RE-" : "") + (buySignal or reBuy ? "BUY " : "SELL ") + syminfo.ticker + " @ " + str.tostring(close, format.mintick) +
         " | stop " + str.tostring(slPx, format.mintick) + (useTrail ? " (trailing)" : " | TP " + str.tostring(tpPx, format.mintick)) +
         (showSize and not na(posQty) ? " | grootte " + fmtQty(posQty) + " " + syminfo.basecurrency + " (" + str.tostring(riskPct, "#.##") + "% risico)" : "") +
         " | score " + str.tostring(score) + "/" + str.tostring(maxScore) + " | ADX " + str.tostring(adx, "#.0"),
         alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD
// ─────────────────────────────────────────────────────────────────────────────
tablePosition(string p) =>
    switch p
        "Rechtsonder" => position.bottom_right
        "Linksboven"  => position.top_left
        "Linksonder"  => position.bottom_left
        => position.top_right

tfText(string tf) =>
    int s = timeframe.in_seconds(tf)
    s >= 2592000 ? str.tostring(s / 2592000, "#") + "M" :
     s >= 604800 ? str.tostring(s / 604800, "#.#") + "W" :
     s >= 86400  ? str.tostring(s / 86400, "#.#") + "D" :
     s >= 3600   ? str.tostring(s / 3600, "#.#") + "H" :
     s >= 60     ? str.tostring(s / 60, "#") + "m" : str.tostring(s) + "s"

string txtSize = tableSize == "Groot" ? size.normal : tableSize == "Normaal" ? size.small : size.tiny
color  tblBg   = color.new(#131722, 10)
color  keyCol  = color.new(color.white, 25)

setRow(table t, int row, string k, string v, color vCol, color vBg) =>
    table.cell(t, 0, row, k, text_color = keyCol, text_size = txtSize, text_halign = text.align_left, bgcolor = tblBg)
    table.cell(t, 1, row, v, text_color = vCol,   text_size = txtSize, text_halign = text.align_center, bgcolor = vBg)

var table dash = table.new(tablePosition(tablePosIn), 2, 16, bgcolor = tblBg, border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

if showTable and barstate.islast
    color up = colBull
    color dn = colBear
    color nt = colNeutral

    // Trend
    string tTxt = switch trendState
        2  => "STERK BULLISH ▲▲"
        1  => "BULLISH ▲"
        -1 => "BEARISH ▼"
        -2 => "STERK BEARISH ▼▼"
        => sideways ? "ZIJWAARTS ◆" : "NEUTRAAL ◆"
    setRow(dash, 0, "TrendNav " + tfText(timeframe.period), tTxt, color.white, trendCol)

    // Score
    setRow(dash, 1, "Trendscore", (score > 0 ? "+" : "") + str.tostring(score) + " / " + str.tostring(maxScore),
         score > 0 ? up : score < 0 ? dn : nt, tblBg)

    // ADX
    string adxTxt = str.tostring(adx, "#.0") + (adx >= adxStrong ? "  sterk" : adx >= adxMin ? "  trend" : "  zwak") + (adx > adx[1] ? " ↑" : " ↓")
    setRow(dash, 2, "ADX", adxTxt, adx >= adxMin ? color.white : nt, tblBg)

    // DMI
    setRow(dash, 3, "DI+ / DI−", str.tostring(diPlus, "#.0") + " / " + str.tostring(diMinus, "#.0"), diPlus > diMinus ? up : dn, tblBg)

    // EMA-lint & trend
    setRow(dash, 4, "EMA " + str.tostring(lenFast) + "/" + str.tostring(lenSlow), emaFast > emaSlow ? "bullish" : "bearish", emaFast > emaSlow ? up : dn, tblBg)
    setRow(dash, 5, "EMA " + str.tostring(lenMid) + "/" + str.tostring(lenLong),
         (emaMid > emaLong ? "golden" : "death") + (close > emaLong ? " • boven " : " • onder ") + str.tostring(lenLong),
         emaMid > emaLong ? up : dn, tblBg)

    // Volume
    string vTxt = hasVolume ? str.tostring(relVol, "#.00") + "x" + (relVol >= volMult ? "  hoog" : relVol >= 0.8 ? "  normaal" : "  laag") : "n.v.t."
    setRow(dash, 6, "Volume", vTxt, not hasVolume ? nt : relVol >= volMult ? up : relVol >= 0.8 ? color.white : nt, tblBg)

    // RSI
    setRow(dash, 7, "RSI", str.tostring(rsi, "#.0") + (rsi >= rsiOB ? "  overbought" : rsi <= rsiOS ? "  oversold" : ""),
         rsi >= rsiOB or rsi <= rsiOS ? color.yellow : rsi > 50 ? up : dn, tblBg)

    // HTF
    string hTxt = not useHtf ? "uit" : not htfValid ? "HTF < chart" : htfTrend == 1 ? "BULLISH" : htfTrend == -1 ? "BEARISH" : "NEUTRAAL"
    setRow(dash, 8, "HTF " + tfText(htf), hTxt, htfTrend == 1 ? up : htfTrend == -1 ? dn : nt, tblBg)

    // Laatste signaal + statistiek
    int    total  = wins + losses
    string sigTxt = lastSig == 0 ? "—" : (lastSig == 1 ? "BUY" : "SELL") + " • " + str.tostring(bar_index - lastSigBar) + " bars"
    string stTxt  = total > 0 ? "  |  " + str.tostring(100.0 * wins / total, "#") + "% (" + str.tostring(wins) + "/" + str.tostring(total) + ")" : ""
    setRow(dash, 9, "Signaal | hit-rate", sigTxt + stTxt, lastSig == 1 ? up : lastSig == -1 ? dn : nt, tblBg)

    // Open positie
    float  openPnl = posDir != 0 ? posDir * (close / entryPx - 1) * 100 : na
    string posTxt  = posDir == 0 ? "geen" : (posDir == 1 ? "LONG " : "SHORT ") + (openPnl > 0 ? "+" : "") + str.tostring(openPnl, "#.0") + "%" + (ptDone ? " • TP1 ✓" : "") + "  •  stop " + str.tostring(slPx, format.mintick)
    setRow(dash, 10, "Positie", posTxt, posDir == 0 ? nt : openPnl > 0 ? up : dn, tblBg)

    // Open interest & liquidaties
    string oiTxt = hasOi ? (oiChg24 > 0 ? "+" : "") + str.tostring(oiChg24, "#.0") + "% (24u)" : "n.v.t. (zie instellingen)"
    setRow(dash, 11, "Open interest", oiTxt, not hasOi ? nt : oiChg24 > 0 ? up : dn, tblBg)
    string lqTxt = na(lastLiqBar) ? "—" : (lastLiqDir == 1 ? "LONGS geliq. • " : "SHORTS geliq. • ") + str.tostring(bar_index - lastLiqBar) + " bars"
    setRow(dash, 12, "Laatste liq-golf", lqTxt, na(lastLiqBar) ? nt : lastLiqDir == 1 ? colLongLiq : colShortLiq, tblBg)
    float nearUp = na
    float nearDn = na
    if array.size(lvlPx) > 0
        for lp in lvlPx
            if lp > close and (na(nearUp) or lp < nearUp)
                nearUp := lp
            if lp < close and (na(nearDn) or lp > nearDn)
                nearDn := lp
    string upTxt = na(nearUp) ? "—" : "↑ " + str.tostring(nearUp, format.mintick) + " (+" + str.tostring((nearUp / close - 1) * 100, "#.0") + "%)"
    string dnTxt = na(nearDn) ? "—" : "↓ " + str.tostring(nearDn, format.mintick) + " (" + str.tostring((nearDn / close - 1) * 100, "#.0") + "%)"
    // BTC-filter
    string bTxt = not useBtc ? "uit" : isBtc ? "n.v.t. (BTC)" : btcTrend == 1 ? "BTC BULLISH" : btcTrend == -1 ? "BTC BEARISH" : "BTC NEUTRAAL"
    setRow(dash, 14, "BTC-filter", bTxt, btcTrend == 1 ? up : btcTrend == -1 ? dn : nt, tblBg)

    // Positiegrootte
    string szTxt = posDir != 0 and not na(posQty) ? fmtQty(posQty) + " " + syminfo.basecurrency + "  •  " + str.tostring(posQty * entryPx / accSize, "#.##") + "x" :
         "per signaal: " + str.tostring(riskPct, "#.##") + "% = " + str.tostring(accSize * riskPct / 100, "#,###") + " " + syminfo.currency
    setRow(dash, 15, "Positiegrootte", szTxt, posDir == 0 ? nt : color.white, tblBg)

    setRow(dash, 13, "Liq-niveaus", showLiqLvl ? upTxt + "  " + dnTxt : "uit", nt, tblBg)
